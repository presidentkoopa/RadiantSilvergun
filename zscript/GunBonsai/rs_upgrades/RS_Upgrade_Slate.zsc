// =====================================================================
// The designed affix slate -- ten RS-authored GunBonsai upgrades, the
// full workshop record for every one of them in
// docs/rs_09_affix_slate.txt. Read that first; this file is the
// mechanism, the doc is the design.
//
// Shared shape: each affix is takeable 6 times. Takes 1-5 are the
// level ladder; the 6th is the Mastery (a rule change, never bigger
// numbers). Effects land as granted keywords the shot resolver
// (RS_ShotKeywordMods.Resolve) reads fresh every shot -- OnActivate is
// re-runnable (idempotent by reconstruction: ungrant my whole family,
// grant the current level's value), OnDeactivate is a complete undo
// (Promotion's affix-strip depends on that -- RS_GunBonsaiBridge).
//
// EXCLUSION GROUPS (design, enforced in IsSuitableForWeapon):
//   shape:    Splitter <-> Slugger        -- one payload shape per gun
//   identity: Painter <-> Bonecaller <-> Cryo -- one projectile identity
// Everything across groups stacks freely; that's where builds live
// (Seeker + Slugger = the homing slug).
// =====================================================================

// Shared plumbing: the leveled keyword family. A subclass names its
// axis and its per-level value; this base keeps grants consistent and
// deactivation airtight.
class TFLV_Upgrade_RS_SlateBase : TFLV_Upgrade_BaseUpgrade abstract
{
	virtual string KeyAxis() { return "payload"; }

	// Value granted at a given take-count (1..6). "" = grant nothing at
	// this level (identity-only levels, e.g. Bonecaller L1).
	virtual string ValueForLevel(int lvl) { return ""; }

	// Per-affix extras beyond the keyword grant (part-swaps, prices).
	virtual void ExtraActivate(RS_Weapon wpn) {}
	virtual void ExtraDeactivate(RS_Weapon wpn) {}

	void ApplyLeveled(RS_Weapon wpn)
	{
		// Reconstruct, don't accumulate: strip every value this family
		// could ever have granted, then grant exactly the current one.
		// This is what makes OnActivate safely re-runnable at any level
		// with no intervening OnDeactivate (GB's own documented case).
		for (int l = 1; l <= 6; l++)
		{
			string v = ValueForLevel(l);
			if (v != "")
				wpn.UngrantKeyword(KeyAxis(), v);
		}
		string cur = ValueForLevel(clamp(int(level), 1, 6));
		if (cur != "")
			wpn.GrantKeyword(KeyAxis(), cur);
	}

	void RemoveLeveled(RS_Weapon wpn)
	{
		for (int l = 1; l <= 6; l++)
		{
			string v = ValueForLevel(l);
			if (v != "")
				wpn.UngrantKeyword(KeyAxis(), v);
		}
	}

	override void OnActivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
	{
		super.OnActivate(stats, info);
		let wpn = RS_Weapon(info.wpn);
		if (!wpn) return;
		ApplyLeveled(wpn);
		ExtraActivate(wpn);
	}

	override void OnDeactivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
	{
		super.OnDeactivate(stats, info);
		let wpn = RS_Weapon(info.wpn);
		if (!wpn) return;
		RemoveLeveled(wpn);
		ExtraDeactivate(wpn);
	}
}

// ---------------------------------------------------------------------
// 01 SPLITTER -- payload shape. N-way exact wash, deeper per level.
// Mastery: the deterministic fan.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Splitter : TFLV_Upgrade_RS_SlateBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "split2";
			case 2: return "split3";
			case 3: return "split4";
			case 4: return "split5";
			case 5: return "split6";
		}
		return "splitmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return wpn
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HITSCAN))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Slugger") == 0
			&& info.upgrades.Level("TFLV_Upgrade_RS_Splitter") < 6;
	}
}

// ---------------------------------------------------------------------
// 02 SLUGGER -- payload shape. Collapse the volley into one heavy
// round; damage climbs, spread tightens, the round visibly grows.
// Mastery: the slug punches through.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Slugger : TFLV_Upgrade_RS_SlateBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "slug1";
			case 2: return "slug2";
			case 3: return "slug3";
			case 4: return "slug4";
			case 5: return "slug5";
		}
		return "slugmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return wpn
			&& wpn.PelletCount >= 2
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HITSCAN))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Splitter") == 0
			&& info.upgrades.Level("TFLV_Upgrade_RS_Slugger") < 6;
	}
}

// ---------------------------------------------------------------------
// 03 OVERCHARGED -- damage and spread climb together; the sloppiness
// IS the price. Mastery: Focus -- the first shot after a >= 1s pause
// pays no spread penalty. Excluded from zero-spread weapons (GH
// Railgun), where the price would be counterfeit.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Overcharged : TFLV_Upgrade_RS_SlateBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "over1";
			case 2: return "over2";
			case 3: return "over3";
			case 4: return "over4";
			case 5: return "over5";
		}
		return "overmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		if (!wpn) return false;
		let slot = wpn.GetSlot(0);
		let beat = slot ? slot.PeekAt(0) : null;
		return beat
			&& beat.SpreadScale > 0
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HITSCAN))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Overcharged") < 6;
	}
}

