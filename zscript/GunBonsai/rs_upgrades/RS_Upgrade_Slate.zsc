// =====================================================================
// The designed affix slate -- ten RS-authored GunBonsai upgrades, the
// full workshop record for every one of them in
// docs/rs_09_affix_slate.txt. Read that first; this file is the
// mechanism, the doc is the design.
//
// Shared shape: each affix is takeable 6 times. Takes 1-5 are the
// level ladder; the 6th is the Mastery (a rule change, never bigger
// numbers). Effects land as granted keywords the shot resolver
// (RS_ShotKeywordMods.Resolve) reads fresh every shot -- OnActivate is
// re-runnable (idempotent by reconstruction: ungrant my whole family,
// grant the current level's value), OnDeactivate is a complete undo
// (Promotion's affix-strip depends on that -- RS_GunBonsaiBridge).
//
// EXCLUSION GROUPS (design, enforced in IsSuitableForWeapon):
//   shape:    Splitter <-> Slugger        -- one payload shape per gun
//   identity: Painter <-> Bonecaller <-> Cryo -- one projectile identity
// Everything across groups stacks freely; that's where builds live
// (Seeker + Slugger = the homing slug).
// =====================================================================

// Shared plumbing: the leveled keyword family. A subclass names its
// axis and its per-level value; this base keeps grants consistent and
// deactivation airtight.
class TFLV_Upgrade_RS_SlateBase : TFLV_Upgrade_BaseUpgrade abstract
{
	virtual string KeyAxis() { return "payload"; }

	// Value granted at a given take-count (1..6). "" = grant nothing at
	// this level (identity-only levels, e.g. Bonecaller L1).
	virtual string ValueForLevel(int lvl) { return ""; }

	// Per-affix extras beyond the keyword grant (part-swaps, prices).
	virtual void ExtraActivate(RS_Weapon wpn) {}
	virtual void ExtraDeactivate(RS_Weapon wpn) {}

	// GAP #2, closed for real: rs_00 is explicit that Cursed/Trash/Basic
	// "cannot gain GunBonai abilities" -- GunBonaiSockets was rolled per
	// tier from day one but read by nothing until now. Every one of the
	// ten designed affixes gates on it; stat/combo cards (RS_Upgrade_
	// Cards.zsc) deliberately do NOT, so a sockets-0 weapon still gets a
	// real (if affix-free) offer instead of an empty one.
	static bool HasSockets(RS_Weapon wpn)
	{
		return wpn && wpn.GunBonaiSockets > 0;
	}

	// SOCKETS = BREADTH CAP (rs_11, owner's law): the number of DISTINCT
	// affixes a weapon holds may not exceed its sockets (1 Common .. 5
	// Prototype). Re-picking a held affix -- leveling it -- never costs
	// a socket: sockets gate NEW identities, levels are free depth.
	static int DistinctAffixCount(TFLV_WeaponInfo info)
	{
		int n = 0;
		for (int i = 0; i < info.upgrades.upgrades.Size(); i++)
		{
			let u = info.upgrades.upgrades[i];
			if (u.level > 0 && u is "TFLV_Upgrade_RS_SlateBase")
				n++;
		}
		return n;
	}

	// The one gate every slate affix's IsSuitableForWeapon leads with:
	// sockets exist, AND either this affix is already held (leveling is
	// always allowed) or a socket is free for a new identity.
	static bool CanTake(RS_Weapon wpn, TFLV_WeaponInfo info, string myClass)
	{
		if (!HasSockets(wpn)) return false;
		if (info.upgrades.Level(myClass) > 0) return true;
		return DistinctAffixCount(info) < wpn.GunBonaiSockets;
	}

	// =================================================================
	// WHICH FIRING LANE THIS CARD LANDS ON.
	//
	// A weapon has four inputs -- fire, alt-fire, modifier+fire,
	// modifier+alt -- and with a gun in each hand that is the eight
	// firing lanes the owner named. The hand is already decided: a
	// level-up belongs to one WEAPON, and a weapon knows its own hand
	// (bOffhandWeapon). What was undecided is which of that weapon's
	// four inputs a card writes to.
	//
	// Rolled at offer time, in PLAY scope. Not lazily in an accessor:
	// GetName() runs in UI scope and rolling random() there desyncs
	// multiplayer. Not at activation either, because the label has to be
	// readable BEFORE you pick.
	//
	// WHY RANDOM RATHER THAN CHOSEN: a free choice makes every card a
	// four-way submenu and turns a level-up into paperwork. Random costs
	// nothing, keeps the offer surprising, and the gold reassign below
	// is there for when you actually care.
	//
	// -1 means "this card has no lane". True for the 65 family cards --
	// they fire on kills and never touch a profile, so a lane label on
	// them would be noise.
	// =================================================================
	int mLane;
	private bool mLaneRolled;

	// Cards that write axes override this. Default false keeps every
	// on-kill card, stat card and combo card out of the lane system
	// without any of them needing to know it exists.
	virtual bool UsesLane() { return false; }

	int Lane()
	{
		return mLaneRolled ? mLane : -1;
	}

	// Called from the giver once per offer, play scope.
	void RS_RollLane(RS_Weapon wpn)
	{
		if (mLaneRolled || !UsesLane()) return;
		mLaneRolled = true;

		// Slot 0 always exists; 1-3 may be empty on a fresh gun. Landing
		// on an empty one is GOOD and deliberate -- the card CREATES that
		// input. Most guns author only slot 0, so the modifier key does
		// nothing until a card lands there, and a gun grows extra
		// triggers as it levels.
		mLane = random(0, RS_Weapon.RS_SLOT_COUNT - 1);
	}

	static string LaneName(int lane)
	{
		if (lane == RS_Weapon.RS_SLOT_PRIMARY)    return "FIRE";
		if (lane == RS_Weapon.RS_SLOT_SECONDARY)  return "ALT-FIRE";
		if (lane == RS_Weapon.RS_SLOT_TERTIARY)   return "MOD+FIRE";
		if (lane == RS_Weapon.RS_SLOT_QUATERNARY) return "MOD+ALT";
		return "";
	}

	// =================================================================
	// AXIS CLAIMS -- how a card changes what the gun FIRES.
	//
	// RS_Weapon carries an Affix* override per axis, and the shot
	// resolver reads them first: affix -> the shot's own -> the gun's ->
	// catalog default. So a card that claims only a trail still fires
	// with the gun's own bang, brass and flash. That four-rung fallback
	// is what makes a partial card work, and it is why a card should
	// claim TWO OR THREE axes rather than all eight -- an eight-axis
	// card is a different gun, a three-axis card is a modification.
	//
	// Bonecaller, Cacospit, Cryo, ArachPlasma, Swarm and Nova each used
	// to do this by hand -- assign the field, then in deactivate compare
	// the current value back against the literal they wrote and null it
	// on a match. Correct, but it only held while nothing cleared the
	// fields wholesale, and RS_AffixInstall.UninstallParts did exactly
	// that. All six now route through the same ledger as everything
	// else, and their deactivates collapse to one ReleaseAxes call.
	// =================================================================

	// Every claim routes through RS_Weapon's axis ledger, which records
	// the owner alongside the value. The card's own class name is the
	// owner key -- valid because a card levels rather than stacking, so
	// there is never a second live instance of the same class on one gun.
	//
	// These used to keep private mClaim* copies and compare them back
	// against the weapon. That worked, but only as long as nothing else
	// cleared the fields wholesale -- and RS_AffixInstall did exactly
	// that. The ledger moves the bookkeeping to the one place every
	// writer can see it.

	void ClaimProj(RS_Weapon wpn, Class<Actor> c)
	{
		if (wpn) wpn.SetAxisClass(RS_FXRegistry.RS_FXAXIS_PROJECTILE, c, GetClassName());
	}
	void ClaimPuff(RS_Weapon wpn, Class<Actor> c)
	{
		if (wpn) wpn.SetAxisClass(RS_FXRegistry.RS_FXAXIS_PUFF, c, GetClassName());
	}
	void ClaimSparks(RS_Weapon wpn, Class<Actor> c)
	{
		if (wpn) wpn.SetAxisClass(RS_FXRegistry.RS_FXAXIS_SPARKS, c, GetClassName());
	}
	void ClaimSmoke(RS_Weapon wpn, Class<Actor> c)
	{
		if (wpn) wpn.SetAxisClass(RS_FXRegistry.RS_FXAXIS_SMOKE, c, GetClassName());
	}
	void ClaimTrail(RS_Weapon wpn, Class<Actor> c)
	{
		if (wpn) wpn.SetAxisClass(RS_FXRegistry.RS_FXAXIS_TRAIL, c, GetClassName());
	}
	void ClaimSound(RS_Weapon wpn, sound s)
	{
		// Layered channel, never the gun's own report -- the report is an
		// identity anchor. SetAxisSound defaults to that for the same
		// reason, so this passes nothing extra.
		if (wpn) wpn.SetAxisSound(s, GetClassName());
	}
	void ClaimCasing(RS_Weapon wpn, string c)
	{
		if (wpn) wpn.SetAxisCasing(c, GetClassName());
	}
	// PAYLOAD, via the explosion visual -- the only Affix* field that
	// corresponds to "what the payload looks like when it goes off".
	// Filed under the PAYLOAD axis id in the ledger so a payload card
	// releases it correctly.
	void SetPayloadVisual(RS_Weapon wpn, Class<Actor> c)
	{
		if (wpn) wpn.SetAxisClass(RS_FXRegistry.RS_FXAXIS_PAYLOAD, c, GetClassName());
	}
	// MUZZLE. The one axis with no gun floor behind it: RS_Main emits no
	// muzzle light of its own and defers to GlowInTheDark, so a card
	// claiming this adds a second light rather than overriding one.
	void ClaimMuzzle(RS_Weapon wpn, Class<Actor> c)
	{
		if (wpn) wpn.SetAxisClass(RS_FXRegistry.RS_FXAXIS_MUZZLE, c, GetClassName());
	}

	// Release every axis this card owns, and only those. One call now --
	// the ledger knows which ones they are.
	void ReleaseAxes(RS_Weapon wpn)
	{
		if (wpn) wpn.ReleaseAxesBy(GetClassName());
	}

	// Write a registry draw to an axis by axis id. One switch instead of
	// a call-site if-chain in every card that wants to be axis-driven.
	void ClaimByAxis(RS_Weapon wpn, int axis, Class<Actor> c)
	{
		if (!c) return;
		if (axis == RS_FXRegistry.RS_FXAXIS_PROJECTILE) ClaimProj(wpn, c);
		else if (axis == RS_FXRegistry.RS_FXAXIS_PUFF)   ClaimPuff(wpn, c);
		else if (axis == RS_FXRegistry.RS_FXAXIS_SPARKS) ClaimSparks(wpn, c);
		else if (axis == RS_FXRegistry.RS_FXAXIS_SMOKE)  ClaimSmoke(wpn, c);
		else if (axis == RS_FXRegistry.RS_FXAXIS_TRAIL)  ClaimTrail(wpn, c);
		else if (axis == RS_FXRegistry.RS_FXAXIS_MUZZLE) ClaimMuzzle(wpn, c);
		// CASING is a string field, not a class one -- but a card handing
		// us a class still means "eject this", so convert rather than
		// drop. Silently discarding it made FlourishCasing and EchoCasing
		// complete no-ops: they drew a valid entry from the registry's
		// 7 casing entries every time and then threw it away.
		else if (axis == RS_FXRegistry.RS_FXAXIS_CASING)
			ClaimCasing(wpn, c.GetClassName());
		// PAYLOAD has no Affix* field of its own; the nearest real one is
		// the explosion visual, which is what a payload card is actually
		// asking to change. Same story as casing -- FlourishPayload and
		// EchoPayload drew from 66 payload entries and discarded them.
		else if (axis == RS_FXRegistry.RS_FXAXIS_PAYLOAD)
			SetPayloadVisual(wpn, c);
	}

	// PROJECTILE IDENTITY EXCLUSION GROUP. A gun's rounds are ONE thing:
	// caco bile, bone tracers, pain orbs, arach plasma, a bee swarm, or
	// a nova shell -- never two at once. Returns true only if no OTHER
	// identity is currently held.
	//
	// Comparison chain, not an array: this engine build does not resolve
	// array literals in class bodies (CLAUDE.md, three real bugs).
	static bool IdentityHeld(TFLV_WeaponInfo info, string cls, string mine)
	{
		return cls != mine && info.upgrades.Level(cls) > 0;
	}

	static bool IdentityFree(TFLV_WeaponInfo info, string mine)
	{
		if (IdentityHeld(info, "TFLV_Upgrade_RS_Cacospit",    mine)) return false;
		if (IdentityHeld(info, "TFLV_Upgrade_RS_Bonecaller",  mine)) return false;
		if (IdentityHeld(info, "TFLV_Upgrade_RS_PainOrb",     mine)) return false;
		if (IdentityHeld(info, "TFLV_Upgrade_RS_ArachPlasma", mine)) return false;
		if (IdentityHeld(info, "TFLV_Upgrade_RS_Swarm",       mine)) return false;
		if (IdentityHeld(info, "TFLV_Upgrade_RS_Nova",        mine)) return false;
		return true;
	}

	void ApplyLeveled(RS_Weapon wpn)
	{
		// Reconstruct, don't accumulate: strip every value this family
		// could ever have granted, then grant exactly the current one.
		// This is what makes OnActivate safely re-runnable at any level
		// with no intervening OnDeactivate (GB's own documented case).
		for (int l = 1; l <= 6; l++)
		{
			string v = ValueForLevel(l);
			if (v != "")
				wpn.UngrantKeyword(KeyAxis(), v);
		}
		string cur = ValueForLevel(clamp(int(level), 1, 6));
		if (cur != "")
			wpn.GrantKeyword(KeyAxis(), cur);
	}

	void RemoveLeveled(RS_Weapon wpn)
	{
		for (int l = 1; l <= 6; l++)
		{
			string v = ValueForLevel(l);
			if (v != "")
				wpn.UngrantKeyword(KeyAxis(), v);
		}
	}

	override void OnActivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
	{
		super.OnActivate(stats, info);
		let wpn = RS_Weapon(info.wpn);
		if (!wpn) return;
		ApplyLeveled(wpn);
		ExtraActivate(wpn);
	}

	override void OnDeactivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
	{
		super.OnDeactivate(stats, info);
		let wpn = RS_Weapon(info.wpn);
		if (!wpn) return;
		RemoveLeveled(wpn);
		ExtraDeactivate(wpn);
	}
}

// ---------------------------------------------------------------------
// 01 SPLITTER -- payload shape. N-way exact wash, deeper per level.
// Mastery: the deterministic fan.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Splitter : TFLV_Upgrade_RS_SlateBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "split2";
			case 2: return "split3";
			case 3: return "split4";
			case 4: return "split5";
			case 5: return "split6";
		}
		return "splitmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Splitter")
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HITSCAN))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Slugger") == 0
			&& info.upgrades.Level("TFLV_Upgrade_RS_Splitter") < 6;
	}
}

// ---------------------------------------------------------------------
// 02 SLUGGER -- payload shape. Collapse the volley into one heavy
// round; damage climbs, spread tightens, the round visibly grows.
// Mastery: the slug punches through.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Slugger : TFLV_Upgrade_RS_SlateBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "slug1";
			case 2: return "slug2";
			case 3: return "slug3";
			case 4: return "slug4";
			case 5: return "slug5";
		}
		return "slugmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Slugger")
			&& wpn.PelletCount >= 2
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HITSCAN))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Splitter") == 0
			&& info.upgrades.Level("TFLV_Upgrade_RS_Slugger") < 6;
	}
}

// ---------------------------------------------------------------------
// 03 OVERCHARGED -- damage and spread climb together; the sloppiness
// IS the price. Mastery: Focus -- the first shot after a >= 1s pause
// pays no spread penalty. Excluded from zero-spread weapons (GH
// Railgun), where the price would be counterfeit.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Overcharged : TFLV_Upgrade_RS_SlateBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "over1";
			case 2: return "over2";
			case 3: return "over3";
			case 4: return "over4";
			case 5: return "over5";
		}
		return "overmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		if (!CanTake(wpn, info, "TFLV_Upgrade_RS_Overcharged")) return false;
		let slot = wpn.GetSlot(0);
		let beat = slot ? slot.PeekAt(0) : null;
		return beat
			&& beat.SpreadScale > 0
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HITSCAN))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Overcharged") < 6;
	}
}

// ---------------------------------------------------------------------
// 04 GIANT -- the joke that's secretly a build. Scale is visual AND
// hitbox; price-free identity. Mastery: Wrecking Ball kickback.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Giant : TFLV_Upgrade_RS_SlateBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "giant1";
			case 2: return "giant2";
			case 3: return "giant3";
			case 4: return "giant4";
			case 5: return "giant5";
		}
		return "giantmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Giant")
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HEAVY))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Giant") < 6;
	}
}

// ---------------------------------------------------------------------
// 05 SEEKER -- behavior. Homes true from L1; levels buy retarget
// cycling across more victims. Price: -5% damage per level. Mastery:
// unlimited cycling, precise tracking, curves around corners.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Seeker : TFLV_Upgrade_RS_SlateBase
{
	override string KeyAxis() { return "behavior"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "seek1";
			case 2: return "seek2";
			case 3: return "seek3";
			case 4: return "seek4";
			case 5: return "seek5";
		}
		return "seekmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Seeker")
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HEAVY))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Seeker") < 6;
	}
}

// ---------------------------------------------------------------------
// 06 GHOST -- behavior. Rounds punch through victims; retention decay
// per punch IS the price. Bullet-only (a ripping rocket is a bug
// generator, and hitscan has nothing to rip). Mastery: the stitch.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Ghost : TFLV_Upgrade_RS_SlateBase
{
	override string KeyAxis() { return "behavior"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "pierce1";
			case 2: return "pierce2";
			case 3: return "pierce3";
			case 4: return "pierce4";
			case 5: return "pierce5";
		}
		return "piercemaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Ghost")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& info.upgrades.Level("TFLV_Upgrade_RS_Ghost") < 6;
	}
}

// ---------------------------------------------------------------------
// 07 PAINTER -- first element identity (thermal). Part-swap: the gun's
// rounds BECOME fire, rolled once from a two-family wardrobe (Wisp /
// Ember) the moment the affix is taken -- that roll is this gun's fire
// forever. Levels: +3% damage each, identity-first. Mastery: impacts
// ignite the ground.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Cacospit : TFLV_Upgrade_RS_SlateBase
{
	// THE ROLL, and a separate flag saying whether it has happened.
	//
	// This used to be "-1 = not yet rolled" on WardrobeRoll alone, and
	// that sentinel could never be observed: ZScript zero-initialises a
	// new object's fields, so a fresh Cacospit arrives with
	// WardrobeRoll == 0, and the guard below (`< 0 || > 1`) read that as
	// an already-made roll of zero. Random(0,1) therefore NEVER RAN.
	// Every Cacospit gun in the game got family A (RS_AffixCacoBall),
	// and RS_AffixFireWisp was unreachable content -- defined, spawnable,
	// referenced by the parts file, and impossible to ever see.
	//
	// The Init() below that sets -1 has zero callers anywhere in the
	// tree (GB constructs upgrades with a bare new()), so it could not
	// rescue it either.
	//
	// A bool cannot be faked by zero-init the way a sentinel value can:
	// false is exactly "not rolled yet", which is the truth for a fresh
	// object.
	int  WardrobeRoll;
	bool WardrobeRolled;

	override string KeyAxis() { return "element"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "fire1";
			case 2: return "fire2";
			case 3: return "fire3";
			case 4: return "fire4";
			case 5: return "fire5";
		}
		return "firemaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		if (!WardrobeRolled)
		{
			WardrobeRoll = Random(0, 1);
			WardrobeRolled = true;
		}
		ClaimProj(wpn, (WardrobeRoll == 0)
			? (Class<Actor>)("RS_AffixCacoBall")
			: (Class<Actor>)("RS_AffixFireWisp"));
		// AffixExtraFireSound, NOT AffixFireSound. Converted 2026-08-08:
		// axis 5 is an OVERRIDE, so setting it here silenced the weapon's
		// own report and a caco-round shotgun sounded like ONLY a caco.
		// The owner's rule is that the gun's report is an identity anchor
		// -- it should sound like a shotgun firing something strange, not
		// like the strange thing alone. This field layers on its own
		// channel instead. Same applies to every themed voice below.
		ClaimSound(wpn, "caco/attack");
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		// Null only what is still ours -- single-slot layer, last writer
		// wins, and the exclusion group should make collisions
		// impossible, but deactivation stays polite anyway. Explicit
		// class-lookup casts: Class<Actor> == string is not a reliable
		// comparison in this engine.
		// One call: the ledger knows which axes carry this card's name.
		ReleaseAxes(wpn);
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Cacospit")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& IdentityFree(info, "TFLV_Upgrade_RS_Cacospit")
			&& info.upgrades.Level("TFLV_Upgrade_RS_Cacospit") < 6;
	}

	// Fresh roll if this affix is ever re-taken after a Promotion strip.
	//
	// NOTE: this has no callers -- GunBonsai builds upgrades with a bare
	// new() (Registry.zsc, WeaponInfo.zsc), so it has never run. It is
	// kept because it is correct and harmless, and because a Promotion
	// strip destroys the upgrade object anyway: the replacement arrives
	// with WardrobeRolled false and re-rolls on its own. If a future
	// construction path ever wants an explicit reset, this is it.
	TFLV_Upgrade_RS_Cacospit Init()
	{
		WardrobeRoll = 0;
		WardrobeRolled = false;
		return self;
	}
}

// ---------------------------------------------------------------------
// 08 BONECALLER -- monster-part signature. Rounds become Revenant bone
// tracers (vanilla sprite + vanilla skeleton audio, zero asset risk).
// L1 is pure identity; L2-4 give each PELLET a growing chance to hunt;
// L5 all rounds hunt. Mastery: twin-fire -- every round doubles into a
// straight+seeking pair at half damage each. Exact wash, double dread.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Bonecaller : TFLV_Upgrade_RS_SlateBase
{
	override string KeyAxis() { return "behavior"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "";              // identity only, an exact wash
			case 2: return "bonechance25";
			case 3: return "bonechance50";
			case 4: return "bonechance75";
			case 5: return "bonechance100";
		}
		return "bonemaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		ClaimProj(wpn, "RS_AffixBoneTracer");
		ClaimSound(wpn, "skeleton/attack");
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		// One call: the ledger knows which axes carry this card's name.
		ReleaseAxes(wpn);
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Bonecaller")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& IdentityFree(info, "TFLV_Upgrade_RS_Bonecaller")
			&& info.upgrades.Level("TFLV_Upgrade_RS_Bonecaller") < 6;
	}
}

// ---------------------------------------------------------------------
// 09 PAIN ORB -- Monster Signature (the elemental "Cryo" is dead;
// this is its plumbing re-aimed). The Pain Elemental's bouncing ice
// orb -- ITS OWN sourced part (RS_IceOrbCyanAra, pe_projectiles) --
// as your round, bouncing from LEVEL 1 because the bounce IS the
// identity (first plain-Actor player round; FastProjectile can't
// bounce). +6% dmg/lvl; the price is real chambered rounds: -1
// Capacity per 2 levels, restored exactly on removal. MASTERY: the
// orb grows, bounces six times, and shatters into a shard spray.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_PainOrb : TFLV_Upgrade_RS_SlateBase
{
	// Exactly how much Capacity we are currently holding -- restored
	// before every re-apply and on deactivate, so level changes can
	// never drift or double-charge.
	int AppliedCapCut;

	override string KeyAxis() { return "element"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "ice1";
			case 2: return "ice2";
			case 3: return "ice3";
			case 4: return "ice4";
			case 5: return "ice5";
		}
		return "icemaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		ClaimProj(wpn, (level >= 6)
			? (Class<Actor>)("RS_AffixPainOrbMaster")
			: (Class<Actor>)("RS_AffixIceOrb"));
		ClaimSound(wpn, "rs_fx_ice_cast");

		// The price: heavier rounds, fewer chambered. Restore-then-apply
		// keeps this exact across re-activations and level-ups.
		wpn.Capacity += AppliedCapCut;
		AppliedCapCut = min(int(level) / 2, wpn.Capacity - 1);
		AppliedCapCut = max(0, AppliedCapCut);
		wpn.Capacity -= AppliedCapCut;
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		// One call: the ledger knows which axes carry this card's name.
		ReleaseAxes(wpn);
		wpn.Capacity += AppliedCapCut;
		AppliedCapCut = 0;
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_PainOrb")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& IdentityFree(info, "TFLV_Upgrade_RS_PainOrb")
			&& info.upgrades.Level("TFLV_Upgrade_RS_PainOrb") < 6;
	}
}

// ---------------------------------------------------------------------
// 10 ECHO -- the rotation-layer showpiece; first real consumer of the
// beat machinery (PadTo/Replace were built for exactly this and used
// by nothing). Every Nth trigger pull is a free enhanced beat: costs
// no ammo, fires a cluster round. L1 every 7th -> L5 every 3rd.
// Mastery: every 2nd.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Echo : TFLV_Upgrade_RS_SlateBase
{
	// The weapon's own authored beat, captured before we ever touch the
	// rotation -- the exact object, not a clone, so deactivation
	// restores the true original.
	RS_AttackProfile SavedOriginal;

	override string ValueForLevel(int lvl) { return ""; }   // no keywords; pure rotation

	override void ExtraActivate(RS_Weapon wpn)
	{
		let slot = wpn.GetSlot(0);
		if (!slot) return;

		if (!SavedOriginal)
		{
			// First touch: only adopt a rotation we understand (the
			// universal single-beat case -- true of all 32 weapons
			// today). Anything else, leave alone.
			if (slot.Count() != 1) return;
			SavedOriginal = slot.PeekAt(0);
		}

		// Reconstruct the whole rotation from scratch each activation --
		// idempotent at any level, no drift.
		//
		// AUDIT REWORK (rs_11, identity test): the old echo was a FREE
		// fixed cluster beat -- it ignored the Capacity roll and played
		// identically on every gun. The echo is now YOUR OWN SHOT,
		// DOUBLED: two full-damage rounds of this gun's own profile, at
		// DOUBLE ammo cost. (multi's 0.5x2 wash x the 2.0 DamageMult =
		// two rounds at full damage each.) Capacity and ammo economy
		// matter MORE with Echo, not less; an SSG's echo and an SMG's
		// echo are now entirely different beasts because the roll is.
		int n = (level >= 6) ? 2 : max(3, 8 - int(level));

		// OWN ENTRIES ONLY. This was slot.Clear() followed by rebuilding
		// from SavedOriginal, which wiped the entire slot -- every PACK
		// beat Salvage or an Attune card had installed went with it. The
		// suitability check below only guards the FIRST take (it demands
		// Count() == 1), so Echo -> Salvage -> level Echo silently
		// destroyed Salvage's work.
		//
		// Removing only what Echo owns leaves the slot holding the gun's
		// authored beat plus anyone else's, and Echo rebuilds its own
		// padding and its echo beat on top. Two rotation cards on one gun
		// now compose instead of the later one erasing the earlier.
		string me = GetClassName();
		slot.RemoveOwnedBy(me);

		slot.PadToOwned(n, SavedOriginal, me);

		let echo = SavedOriginal.Clone();
		echo.AmmoCost = SavedOriginal.AmmoCost * 2;
		echo.DamageMult *= 2.0;
		echo.GrantLocal("payload", "multi");
		echo.ProfileName = "Echo";
		echo.OwnerTag = me;
		slot.Append(echo);
		slot.ResetCursor();
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		if (!SavedOriginal) return;
		let slot = wpn.GetSlot(0);
		if (!slot) return;
		// Likewise: take back Echo's padding and its echo beat, and leave
		// the gun's own opener and every other card's beats standing.
		slot.RemoveOwnedBy(GetClassName());
		slot.ResetCursor();
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		if (!CanTake(wpn, info, "TFLV_Upgrade_RS_Echo")) return false;
		let slot = wpn.GetSlot(0);
		let beat = slot ? slot.PeekAt(0) : null;
		if (!beat) return false;
		bool modeOK = beat.Mode == RS_ATK_BULLET || beat.Mode == RS_ATK_HITSCAN;
		// After first take the rotation is ours (Count > 1) -- keep
		// offering deeper levels; before it, only adopt single-beat.
		bool shapeOK = slot.Count() == 1
			|| info.upgrades.Level("TFLV_Upgrade_RS_Echo") > 0;
		return modeOK && shapeOK
			&& info.upgrades.Level("TFLV_Upgrade_RS_Echo") < 6;
	}
}

// =====================================================================
// WAVE D1 -- MONSTER SIGNATURES (docs/rs_13). "Your bullets become a
// monster's own ammunition." All three join the PROJECTILE IDENTITY
// exclusion group with Cacospit/Bonecaller/PainOrb: a gun's rounds are
// one thing, never three at once.
//
// Shared identity gate -- every identity affix asks the same question,
// so it lives here instead of being copy-pasted six times.
// =====================================================================
class TFLV_Upgrade_RS_SignatureBase : TFLV_Upgrade_RS_SlateBase abstract
{
	override string KeyAxis() { return "element"; }
}

