			&& info.upgrades.Level("TFLV_Upgrade_RS_Giant") < 6;
	}
}

// ---------------------------------------------------------------------
// 05 SEEKER -- behavior. Homes true from L1; levels buy retarget
// cycling across more victims. Price: -5% damage per level. Mastery:
// unlimited cycling, precise tracking, curves around corners.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Seeker : TFLV_Upgrade_RS_SlateBase
{
	override string KeyAxis() { return "behavior"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "seek1";
			case 2: return "seek2";
			case 3: return "seek3";
			case 4: return "seek4";
			case 5: return "seek5";
		}
		return "seekmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Seeker")
			&& (wpn.HasBeatMode(RS_ATK_BULLET) || wpn.HasBeatMode(RS_ATK_HEAVY))
			&& info.upgrades.Level("TFLV_Upgrade_RS_Seeker") < 6;
	}
}

// ---------------------------------------------------------------------
// 06 GHOST -- behavior. Rounds punch through victims; retention decay
// per punch IS the price. Bullet-only (a ripping rocket is a bug
// generator, and hitscan has nothing to rip). Mastery: the stitch.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Ghost : TFLV_Upgrade_RS_SlateBase
{
	override string KeyAxis() { return "behavior"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "pierce1";
			case 2: return "pierce2";
			case 3: return "pierce3";
			case 4: return "pierce4";
			case 5: return "pierce5";
		}
		return "piercemaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Ghost")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& info.upgrades.Level("TFLV_Upgrade_RS_Ghost") < 6;
	}
}

// ---------------------------------------------------------------------
// 07 PAINTER -- first element identity (thermal). Part-swap: the gun's
// rounds BECOME fire, rolled once from a two-family wardrobe (Wisp /
// Ember) the moment the affix is taken -- that roll is this gun's fire
// forever. Levels: +3% damage each, identity-first. Mastery: impacts
// ignite the ground.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Cacospit : TFLV_Upgrade_RS_SlateBase
{
	// -1 = not yet rolled. Rolled exactly once per upgrade instance --
	// GB persists this object for the weapon's whole life, so the
	// wardrobe roll is permanent until Promotion strips the affix.
	int WardrobeRoll;

	override string KeyAxis() { return "element"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "fire1";
			case 2: return "fire2";
			case 3: return "fire3";
			case 4: return "fire4";
			case 5: return "fire5";
		}
		return "firemaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		if (WardrobeRoll < 0 || WardrobeRoll > 1)
			WardrobeRoll = Random(0, 1);
		wpn.AffixProjectile = (WardrobeRoll == 0)
			? (Class<Actor>)("RS_AffixCacoBall")
			: (Class<Actor>)("RS_AffixFireWisp");
		wpn.AffixFireSound = "caco/attack";
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		// Null only what is still ours -- single-slot layer, last writer
		// wins, and the exclusion group should make collisions
		// impossible, but deactivation stays polite anyway. Explicit
		// class-lookup casts: Class<Actor> == string is not a reliable
		// comparison in this engine.
		if (wpn.AffixProjectile == (Class<Actor>)("RS_AffixCacoBall")
			|| wpn.AffixProjectile == (Class<Actor>)("RS_AffixFireWisp"))
			wpn.AffixProjectile = null;
		if (wpn.AffixFireSound == "caco/attack")
			wpn.AffixFireSound = "";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Cacospit")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& IdentityFree(info, "TFLV_Upgrade_RS_Cacospit")
			&& info.upgrades.Level("TFLV_Upgrade_RS_Cacospit") < 6;
	}

	// Fresh roll if this affix is ever re-taken after a Promotion strip.
	TFLV_Upgrade_RS_Cacospit Init()
	{
		WardrobeRoll = -1;
		return self;
	}
}

// ---------------------------------------------------------------------
// 08 BONECALLER -- monster-part signature. Rounds become Revenant bone
// tracers (vanilla sprite + vanilla skeleton audio, zero asset risk).
// L1 is pure identity; L2-4 give each PELLET a growing chance to hunt;
// L5 all rounds hunt. Mastery: twin-fire -- every round doubles into a
// straight+seeking pair at half damage each. Exact wash, double dread.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Bonecaller : TFLV_Upgrade_RS_SlateBase
{
	override string KeyAxis() { return "behavior"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "";              // identity only, an exact wash
			case 2: return "bonechance25";
			case 3: return "bonechance50";
			case 4: return "bonechance75";
			case 5: return "bonechance100";
		}
		return "bonemaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		wpn.AffixProjectile = "RS_AffixBoneTracer";
		wpn.AffixFireSound = "skeleton/attack";
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		if (wpn.AffixProjectile == (Class<Actor>)("RS_AffixBoneTracer"))
			wpn.AffixProjectile = null;
		if (wpn.AffixFireSound == "skeleton/attack")
			wpn.AffixFireSound = "";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Bonecaller")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& IdentityFree(info, "TFLV_Upgrade_RS_Bonecaller")
			&& info.upgrades.Level("TFLV_Upgrade_RS_Bonecaller") < 6;
	}
}

// ---------------------------------------------------------------------
// 09 PAIN ORB -- Monster Signature (the elemental "Cryo" is dead;
// this is its plumbing re-aimed). The Pain Elemental's bouncing ice
// orb -- ITS OWN sourced part (RS_IceOrbCyanAra, pe_projectiles) --
// as your round, bouncing from LEVEL 1 because the bounce IS the
// identity (first plain-Actor player round; FastProjectile can't
// bounce). +6% dmg/lvl; the price is real chambered rounds: -1
// Capacity per 2 levels, restored exactly on removal. MASTERY: the
// orb grows, bounces six times, and shatters into a shard spray.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_PainOrb : TFLV_Upgrade_RS_SlateBase
{
	// Exactly how much Capacity we are currently holding -- restored
	// before every re-apply and on deactivate, so level changes can
	// never drift or double-charge.
	int AppliedCapCut;

	override string KeyAxis() { return "element"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "ice1";
			case 2: return "ice2";
			case 3: return "ice3";
			case 4: return "ice4";
			case 5: return "ice5";
		}
		return "icemaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		wpn.AffixProjectile = (level >= 6)
			? (Class<Actor>)("RS_AffixPainOrbMaster")
			: (Class<Actor>)("RS_AffixIceOrb");
		wpn.AffixFireSound = "rs_fx_ice_cast";

		// The price: heavier rounds, fewer chambered. Restore-then-apply
		// keeps this exact across re-activations and level-ups.
		wpn.Capacity += AppliedCapCut;
		AppliedCapCut = min(int(level) / 2, wpn.Capacity - 1);
		AppliedCapCut = max(0, AppliedCapCut);
		wpn.Capacity -= AppliedCapCut;
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		if (wpn.AffixProjectile == (Class<Actor>)("RS_AffixIceOrb")
			|| wpn.AffixProjectile == (Class<Actor>)("RS_AffixPainOrbMaster"))
			wpn.AffixProjectile = null;
		if (wpn.AffixFireSound == "rs_fx_ice_cast")
			wpn.AffixFireSound = "";
		wpn.Capacity += AppliedCapCut;
		AppliedCapCut = 0;
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_PainOrb")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& IdentityFree(info, "TFLV_Upgrade_RS_PainOrb")
			&& info.upgrades.Level("TFLV_Upgrade_RS_PainOrb") < 6;
	}
}

// ---------------------------------------------------------------------
// 10 ECHO -- the rotation-layer showpiece; first real consumer of the
// beat machinery (PadTo/Replace were built for exactly this and used
// by nothing). Every Nth trigger pull is a free enhanced beat: costs
// no ammo, fires a cluster round. L1 every 7th -> L5 every 3rd.
// Mastery: every 2nd.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Echo : TFLV_Upgrade_RS_SlateBase
{
	// The weapon's own authored beat, captured before we ever touch the
	// rotation -- the exact object, not a clone, so deactivation
	// restores the true original.
	RS_AttackProfile SavedOriginal;

	override string ValueForLevel(int lvl) { return ""; }   // no keywords; pure rotation

	override void ExtraActivate(RS_Weapon wpn)
	{
		let slot = wpn.GetSlot(0);
		if (!slot) return;

		if (!SavedOriginal)
		{
			// First touch: only adopt a rotation we understand (the
			// universal single-beat case -- true of all 32 weapons
			// today). Anything else, leave alone.
			if (slot.Count() != 1) return;
			SavedOriginal = slot.PeekAt(0);
		}

		// Reconstruct the whole rotation from scratch each activation --
		// idempotent at any level, no drift.
		//
		// AUDIT REWORK (rs_11, identity test): the old echo was a FREE
		// fixed cluster beat -- it ignored the Capacity roll and played
		// identically on every gun. The echo is now YOUR OWN SHOT,
		// DOUBLED: two full-damage rounds of this gun's own profile, at
		// DOUBLE ammo cost. (multi's 0.5x2 wash x the 2.0 DamageMult =
		// two rounds at full damage each.) Capacity and ammo economy
		// matter MORE with Echo, not less; an SSG's echo and an SMG's
		// echo are now entirely different beasts because the roll is.
		int n = (level >= 6) ? 2 : max(3, 8 - int(level));
		slot.Clear();
		slot.Append(SavedOriginal);
		slot.PadTo(n, SavedOriginal);

		let echo = SavedOriginal.Clone();
		echo.AmmoCost = SavedOriginal.AmmoCost * 2;
		echo.DamageMult *= 2.0;
		echo.GrantLocal("payload", "multi");
		echo.ProfileName = "Echo";
		slot.Replace(n - 1, echo);
		slot.ResetCursor();
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		if (!SavedOriginal) return;
		let slot = wpn.GetSlot(0);
		if (!slot) return;
		slot.Clear();
		slot.Append(SavedOriginal);
		slot.ResetCursor();
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		if (!CanTake(wpn, info, "TFLV_Upgrade_RS_Echo")) return false;
		let slot = wpn.GetSlot(0);
		let beat = slot ? slot.PeekAt(0) : null;
		if (!beat) return false;
		bool modeOK = beat.Mode == RS_ATK_BULLET || beat.Mode == RS_ATK_HITSCAN;
		// After first take the rotation is ours (Count > 1) -- keep
		// offering deeper levels; before it, only adopt single-beat.
		bool shapeOK = slot.Count() == 1
			|| info.upgrades.Level("TFLV_Upgrade_RS_Echo") > 0;
		return modeOK && shapeOK
			&& info.upgrades.Level("TFLV_Upgrade_RS_Echo") < 6;
	}
}

// =====================================================================
// WAVE D1 -- MONSTER SIGNATURES (docs/rs_13). "Your bullets become a
// monster's own ammunition." All three join the PROJECTILE IDENTITY
// exclusion group with Cacospit/Bonecaller/PainOrb: a gun's rounds are
// one thing, never three at once.
//
// Shared identity gate -- every identity affix asks the same question,
// so it lives here instead of being copy-pasted six times.
// =====================================================================
class TFLV_Upgrade_RS_SignatureBase : TFLV_Upgrade_RS_SlateBase abstract
{
	override string KeyAxis() { return "element"; }
}

// ---------------------------------------------------------------------
// D1-01 ARACH-PLASMA -- the Arachnotron's relentless bolt. The RATE
// signature: smallest damage ramp of the three because its identity is
// how FAST it speaks, not how hard. Mastery: plasma burns through two
// bodies.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_ArachPlasma : TFLV_Upgrade_RS_SignatureBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "arach1";
			case 2: return "arach2";
			case 3: return "arach3";
			case 4: return "arach4";
			case 5: return "arach5";
		}
		return "arachmaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		wpn.AffixProjectile = "RS_AffixArachPlasma";
		wpn.AffixFireSound = "baby/attack";
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		if (wpn.AffixProjectile == (Class<Actor>)("RS_AffixArachPlasma"))
			wpn.AffixProjectile = null;
		if (wpn.AffixFireSound == "baby/attack")
			wpn.AffixFireSound = "";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_ArachPlasma")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& IdentityFree(info, "TFLV_Upgrade_RS_ArachPlasma")
			&& info.upgrades.Level("TFLV_Upgrade_RS_ArachPlasma") < 6;
	}
}

// ---------------------------------------------------------------------
// D1-08 SWARM -- the Overlord's bee carrier. Levels buy MOTES, not
// damage: the carrier still lands the weapon's own rolled damage, and
// the swarm is what grows. Mastery: the motes hunt.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Swarm : TFLV_Upgrade_RS_SignatureBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "swarm1";
			case 2: return "swarm2";
			case 3: return "swarm3";
			case 4: return "swarm4";
			case 5: return "swarm5";
		}
		return "swarmmaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		wpn.AffixProjectile = "RS_AffixSwarmCarrier";
		wpn.AffixFireSound = "rs_fx_impact_bullet";
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		if (wpn.AffixProjectile == (Class<Actor>)("RS_AffixSwarmCarrier"))
			wpn.AffixProjectile = null;
		if (wpn.AffixFireSound == "rs_fx_impact_bullet")
			wpn.AffixFireSound = "";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		// Pellet-heavy guns would shed a mote cloud per pellet -- the
		// carrier is a single-round identity. Shotgun family excluded on
		// engine-load grounds, not flavor.
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Swarm")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& wpn.PelletCount <= 3
			&& IdentityFree(info, "TFLV_Upgrade_RS_Swarm")
			&& info.upgrades.Level("TFLV_Upgrade_RS_Swarm") < 6;
	}
}

// ---------------------------------------------------------------------
// D1-04 NOVA -- the Cyberdemon's swoosh shell. The heavy signature:
// every impact detonates into a ring of plasma beads. Levels buy beads
// AND weight. Mastery: the beads seek.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Nova : TFLV_Upgrade_RS_SignatureBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "nova1";
			case 2: return "nova2";
			case 3: return "nova3";
			case 4: return "nova4";
			case 5: return "nova5";
		}
		return "novamaster";
	}

	override void ExtraActivate(RS_Weapon wpn)
	{
		wpn.AffixProjectile = "RS_AffixNovaShell";
		wpn.AffixFireSound = "weapons/bfgf";
	}

	override void ExtraDeactivate(RS_Weapon wpn)
	{
		if (wpn.AffixProjectile == (Class<Actor>)("RS_AffixNovaShell"))
			wpn.AffixProjectile = null;
		if (wpn.AffixFireSound == "weapons/bfgf")
			wpn.AffixFireSound = "";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		// Same engine-load fence as Swarm, tighter: a 20-pellet SSG
		// firing bead novas per pellet is a framerate event.
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Nova")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& wpn.PelletCount <= 2
			&& IdentityFree(info, "TFLV_Upgrade_RS_Nova")
			&& info.upgrades.Level("TFLV_Upgrade_RS_Nova") < 6;
	}
}

// =====================================================================
// WAVE D2 -- GENERAL LANE (docs/rs_11 candidate pool). Archetype-
// agnostic behavior cards. Every one passes the audit: each AMPLIFIES a
// different rolled stat rather than replacing one, and none converge
// (two guns with the same card play differently because their rolls
// differ).
//
// Hook discipline (rs_14 offhand findings): these use the resolver and
// OnKill only. ModifyDamageDealt and Tick reach the MAINHAND bag only,
// so an affix built on them would silently do nothing in the off hand.
// =====================================================================

// ---------------------------------------------------------------------
// D2-01 PAIN TRAIN -- rounds always force a flinch. Amplifies nothing
// numerically; it plays AGAINST the monster ladder's painChance stat,
// which drops hard at high tiers (T12 = 16). Very Doom: stunlock as a
// build, not a stat.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_PainTrain : TFLV_Upgrade_RS_SlateBase
{
	override string KeyAxis() { return "behavior"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "flinch1";
			case 2: return "flinch2";
			case 3: return "flinch3";
			case 4: return "flinch4";
			case 5: return "flinch5";
		}
		return "flinchmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_PainTrain")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& info.upgrades.Level("TFLV_Upgrade_RS_PainTrain") < 6;
	}
}

// ---------------------------------------------------------------------
// D2-02 MOMENTUM -- crits chain. Pure CritChance amplifier: a gun that
// rolled high crit chains constantly, a low-crit gun almost never does.
// The streak lives on the weapon (RS_Weapon.RS_CritStreak), so each
// hand keeps its own rhythm.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Momentum : TFLV_Upgrade_RS_SlateBase
{
	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "momentum1";
			case 2: return "momentum2";
			case 3: return "momentum3";
			case 4: return "momentum4";
			case 5: return "momentum5";
		}
		return "momentummaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		// A gun that can never crit can never chain -- don't sell it.
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Momentum")
			&& wpn.CritChance > 0
			&& info.upgrades.Level("TFLV_Upgrade_RS_Momentum") < 6;
	}
}

// ---------------------------------------------------------------------
// D2-03 OVERKILL -- damage past a kill isn't wasted; it detonates on
// the corpse. Damage-roll amplifier: the harder the gun hits, the more
// overkill there is to spend. OnKill is hand-correct in both hands.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Overkill : TFLV_Upgrade_RS_SlateBase
{
	// No keyword -- this one is pure hook.
	override string ValueForLevel(int lvl) { return ""; }

	override void OnKill(PlayerPawn pawn, Actor shot, Actor target)
	{
		if (!target) return;
		// health is negative past death: that IS the overkill.
		int excess = -target.health;
		if (excess <= 0) return;

		// Fraction of the waste that carries, and a cap so a BFG corpse
		// doesn't level the room. Mastery converts the full excess.
		double frac = (level >= 6) ? 1.0 : 0.20 * level;
		int cap = (level >= 6) ? 400 : 60 * int(level);
		int dmg = clamp(int(excess * frac), 0, cap);
		if (dmg <= 0) return;

		target.A_Explode(dmg, 96 + 8 * int(level), 0, false);
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Overkill")
			&& info.upgrades.Level("TFLV_Upgrade_RS_Overkill") < 6;
	}
}

// ---------------------------------------------------------------------
// D2-04 SCAVENGER -- a kill on a nearly-dry magazine gives rounds back.
// Capacity-roll amplifier in the honest direction: a big magazine makes
// the "nearly dry" window rarer but the refund bigger, a small one
// triggers constantly for a little. Mastery: a full reload.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Scavenger : TFLV_Upgrade_RS_SlateBase
{
	// OnKill hands us no weapon reference, so remember ours at activate.
	RS_Weapon wpnRef;

	override string ValueForLevel(int lvl) { return ""; }

	override void OnKill(PlayerPawn pawn, Actor shot, Actor target)
	{
		let wpn = wpnRef;
		if (!wpn || !wpn.AmmoType2 || !pawn) return;

		int have = pawn.CountInv(wpn.AmmoType2);
		int cap = max(1, wpn.Capacity);
		// Only when the magazine is genuinely low -- bottom quarter.
		if (have > cap / 4) return;

		int give = (level >= 6) ? cap : max(1, int(cap * 0.10 * level));
		give = min(give, cap - have);
		if (give > 0)
			pawn.GiveInventory(wpn.AmmoType2, give);
	}

	override void ExtraActivate(RS_Weapon wpn) { wpnRef = wpn; }
	override void ExtraDeactivate(RS_Weapon wpn) { wpnRef = null; }

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		// Needs a real magazine to refill.
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Scavenger")
			&& wpn.AmmoType2 != null
			&& wpn.Capacity > 1
			&& info.upgrades.Level("TFLV_Upgrade_RS_Scavenger") < 6;
	}
}
