// =====================================================================
// WAVE D2 -- GENERAL LANE (docs/rs_11 candidate pool). Archetype-
// agnostic behavior cards. Every one passes the audit: each AMPLIFIES a
// different rolled stat rather than replacing one, and none converge
// (two guns with the same card play differently because their rolls
// differ).
//
// Hook discipline (rs_14 offhand findings): these use the resolver and
// OnKill only. ModifyDamageDealt and Tick reach the MAINHAND bag only,
// so an affix built on them would silently do nothing in the off hand.
// =====================================================================

// ---------------------------------------------------------------------
// D2-01 PAIN TRAIN -- rounds always force a flinch. Amplifies nothing
// numerically; it plays AGAINST the monster ladder's painChance stat,
// which drops hard at high tiers (T12 = 16). Very Doom: stunlock as a
// build, not a stat.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_PainTrain : TFLV_Upgrade_RS_SlateBase
{
	// "element", not "behavior" -- the flinch* branch is resolved in
	// RS_KeywordEffects' ELEMENT loop (:346-453), not the behavior loop
	// (:256-344). Granting on "behavior" put the keyword on an axis
	// nothing reads, so this whole six-level affix was inert: offerable,
	// takeable, and doing nothing.
	override string KeyAxis() { return "element"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "flinch1";
			case 2: return "flinch2";
			case 3: return "flinch3";
			case 4: return "flinch4";
			case 5: return "flinch5";
		}
		return "flinchmaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_PainTrain")
			&& wpn.HasBeatMode(RS_ATK_BULLET)
			&& info.upgrades.Level("TFLV_Upgrade_RS_PainTrain") < 6;
	}
}

// ---------------------------------------------------------------------
// D2-02 MOMENTUM -- crits chain. Pure CritChance amplifier: a gun that
// rolled high crit chains constantly, a low-crit gun almost never does.
// The streak lives on the weapon (RS_Weapon.RS_CritStreak), so each
// hand keeps its own rhythm.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Momentum : TFLV_Upgrade_RS_SlateBase
{
	// Was inheriting the base's default "payload" axis, but the momentum*
	// branch is resolved in RS_KeywordEffects' ELEMENT loop (:426-437).
	// The keyword landed on an axis nothing reads, so the affix was
	// entirely inert -- and INVISIBLY so, because it feeds CritAdd: no
	// missing visual, just a crit chain that never happened.
	override string KeyAxis() { return "element"; }

	override string ValueForLevel(int lvl)
	{
		switch (lvl)
		{
			case 1: return "momentum1";
			case 2: return "momentum2";
			case 3: return "momentum3";
			case 4: return "momentum4";
			case 5: return "momentum5";
		}
		return "momentummaster";
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		// A gun that can never crit can never chain -- don't sell it.
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Momentum")
			&& wpn.CritChance > 0
			&& info.upgrades.Level("TFLV_Upgrade_RS_Momentum") < 6;
	}
}

// ---------------------------------------------------------------------
// D2-03 OVERKILL -- damage past a kill isn't wasted; it detonates on
// the corpse. Damage-roll amplifier: the harder the gun hits, the more
// overkill there is to spend. OnKill is hand-correct in both hands.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Overkill : TFLV_Upgrade_RS_SlateBase
{
	// No keyword -- this one is pure hook.
	override string ValueForLevel(int lvl) { return ""; }

	override void OnKill(PlayerPawn pawn, Actor shot, Actor target)
	{
		if (!target) return;
		// health is negative past death: that IS the overkill.
		int excess = -target.health;
		if (excess <= 0) return;

		// Fraction of the waste that carries, and a cap so a BFG corpse
		// doesn't level the room. Mastery converts the full excess.
		double frac = (level >= 6) ? 1.0 : 0.20 * level;
		int cap = (level >= 6) ? 400 : 60 * int(level);
		int dmg = clamp(int(excess * frac), 0, cap);
		if (dmg <= 0) return;

		// Re-point the corpse at the player BEFORE detonating: A_Explode
		// spares its caller's `target` when XF_HURTSOURCE is unset, so
		// this is what guarantees your own overkill never blows you up.
		// (A corpse's target is usually the player already -- usually is
		// not a safety guarantee.)
		Actor prev = target.target;
		target.target = pawn;
		target.A_Explode(dmg, 96 + 8 * int(level), 0, false);
		target.target = prev;
	}

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Overkill")
			&& info.upgrades.Level("TFLV_Upgrade_RS_Overkill") < 6;
	}
}

// ---------------------------------------------------------------------
// D2-04 SCAVENGER -- a kill on a nearly-dry magazine gives rounds back.
// Capacity-roll amplifier in the honest direction: a big magazine makes
// the "nearly dry" window rarer but the refund bigger, a small one
// triggers constantly for a little. Mastery: a full reload.
// ---------------------------------------------------------------------
class TFLV_Upgrade_RS_Scavenger : TFLV_Upgrade_RS_SlateBase
{
	// OnKill hands us no weapon reference, so remember ours at activate.
	RS_Weapon wpnRef;

	override string ValueForLevel(int lvl) { return ""; }

	override void OnKill(PlayerPawn pawn, Actor shot, Actor target)
	{
		let wpn = wpnRef;
		if (!wpn || !wpn.AmmoType2 || !pawn) return;

		int have = pawn.CountInv(wpn.AmmoType2);
		int cap = max(1, wpn.Capacity);
		// Only when the magazine is genuinely low -- bottom quarter.
		if (have > cap / 4) return;

		int give = (level >= 6) ? cap : max(1, int(cap * 0.10 * level));
		give = min(give, cap - have);
		if (give > 0)
			pawn.GiveInventory(wpn.AmmoType2, give);
	}

	override void ExtraActivate(RS_Weapon wpn) { wpnRef = wpn; }
	override void ExtraDeactivate(RS_Weapon wpn) { wpnRef = null; }

	override bool IsSuitableForWeapon(TFLV_WeaponInfo info)
	{
		let wpn = RS_Weapon(info.wpn);
		// Needs a real magazine to refill.
		return CanTake(wpn, info, "TFLV_Upgrade_RS_Scavenger")
			&& wpn.AmmoType2 != null
			&& wpn.Capacity > 1
			&& info.upgrades.Level("TFLV_Upgrade_RS_Scavenger") < 6;
	}
}
