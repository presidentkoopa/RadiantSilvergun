// =====================================================================
// CATALOG CARD BASES.
//
// The catalogs describe 143 monsters across 13 families, 177 FX actors
// across 9 axes, 5 roles and 8 themes. Three affixes reading that was
// not a card set, it was a demo.
//
// This file holds nine parameterized bases. Every actual card is a
// four-line subclass in RS_Upgrade_CatalogCards.zsc that names its
// family, its theme or its axis and nothing else -- the behaviour lives
// here, once, and a bug is fixed in one place rather than a hundred.
//
//   FAMILY cards (x13, one per bestiary family)
//     Conscript  raise one good body of that family on a kill
//     Swarm      raise several cheap ones instead
//     Hunter     kill that family faster
//     Trophy     that family pays out when it dies
//
//   THEME cards (x8, one per registry theme)
//     Brand      hits plant that theme's payload
//     Lock       the gun's PACK beat draws only that theme
//     Surge      kills burst that theme's headline FX
//
//   AXIS cards (x9, one per PACK axis)
//     Flourish   that axis draws its HEADLINE entries on impact
//     Echo       that axis fires a second time, off the kill
//
// 13*4 + 8*3 + 9*2 = 94. The point is not the number: it is that adding
// a monster to RS_MinionCatalog or an FX actor to RS_FXRegistry makes
// every card of the matching family/theme/axis richer with no edit here
// and no new card written.
// =====================================================================

// ---------------------------------------------------------------------
// Shared: family cards. Subclass overrides Family() only.
// ---------------------------------------------------------------------
class RS_CatCard_FamilyBase : TFLV_Upgrade_RS_SlateBase abstract
{
	virtual string Family() { return ""; }

	override string KeyAxis() { return "behavior"; }
	override string ValueForLevel(int lvl) { return ""; }

	// The gun that gets credited. OnKill carries no WeaponInfo, and
	// ReadyWeapon is correct at the instant of the kill -- once the
	// minion token is stamped it keeps paying that weapon for life.
	Weapon Payee(PlayerPawn p)
	{
		return p && p.player ? p.player.ReadyWeapon : null;
	}

	// Every family card gates the same way, so the suitability check is
	// written once. Subclasses supply their own class name because
	// GetClassName() on the upgrade is what CanTake compares against.
	bool CardTakeable(TFLV_WeaponInfo info, string myName)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, myName)
			&& info.upgrades.Level(myName) < 6;
	}

	// -----------------------------------------------------------------
	// BUDGET, ANCHORED TO THE FAMILY'S OWN FLOOR.
	//
	// A flat ladder (6 + 6*level) is wrong here and was wrong on the
	// first pass: bestiary costs run 1 for a black lost soul to 50 for
	// an abyss baron, so a flat budget bought a lost soul instantly and
	// could not afford ANY baron until level 4. Five of the thirteen
	// Levy cards did nothing at all when first taken. A card that does
	// nothing when you pick it is the worst thing a card can be.
	//
	// So the ladder starts at whatever the family's cheapest member
	// costs -- every family card works on the level you take it -- and
	// climbs by a share of that floor, which walks up that family's own
	// roster at a rate proportional to its own spread.
	// -----------------------------------------------------------------
	int FamilyFloor()
	{
		string cheap = RS_MinionCatalog.CheapestIn(Family());
		if (cheap == "") return 0;
		return RS_MinionCatalog.CostOf(cheap);
	}

	int BudgetAt(int lvl, int perLevelPct)
	{
		int f = FamilyFloor();
		if (f <= 0) return 0;
		int step = max(2, f * perLevelPct / 100);
		return f + (lvl - 1) * step;
	}

	// The other half of the balance. Anchoring the budget to the floor
	// means a baron card hands you a baron at level 1, which is only
	// fair if it fires far less often than the lost soul card does.
	// Scaled off the floor cost, so it needs no per-family table and a
	// newly added family is balanced the moment it is costed.
	int ScaleChanceForFamily(int base)
	{
		int f = FamilyFloor();
		if (f <= 12) return base;                  // cheap families, full rate
		return max(2, base * 12 / f);              // baron: ~43% of base
	}
}

// CONSCRIPT -- one good body of the family, budget climbing with level.
class RS_CatCard_ConscriptBase : RS_CatCard_FamilyBase abstract
{
	override void OnKill(PlayerPawn player, Actor shot, Actor target)
	{
		if (!player || !target || level <= 0) return;
		if (RS_Minion.IsMinion(target)) return;          // no compounding
		if (random(1, 100) > ScaleChanceForFamily(min(55, 9 * int(level)))) return;

		let src = Payee(player);
		if (!src) return;

		// Starts at the family's cheapest and climbs ~35% of that per
		// level, so level 1 always raises SOMETHING and level 6 reaches
		// the top of most rosters.
		int budget = BudgetAt(int(level), 35);
		if (budget <= 0) return;

		string what = RS_MinionCatalog.BestFor(budget, Family());
		if (what == "") what = RS_MinionCatalog.CheapestIn(Family());
		if (what == "") return;

		Class<Actor> cls = what;
		if (cls) RS_Minion.Summon(player, src, cls, target.pos, target.angle);
	}
}

// SWARM -- several cheap ones of the family rather than one good one.
class RS_CatCard_SwarmBase : RS_CatCard_FamilyBase abstract
{
	override void OnKill(PlayerPawn player, Actor shot, Actor target)
	{
		if (!player || !target || level <= 0) return;
		if (RS_Minion.IsMinion(target)) return;
		if (random(1, 100) > ScaleChanceForFamily(min(45, 7 * int(level)))) return;

		let src = Payee(player);
		if (!src) return;

		int n = 2 + (int(level) / 2);                    // 2,2,3,3,4, mastery 5

		// Horde buys N bodies, so the budget has to cover N floors, not
		// one. Same anchoring as Levy -- the count is the level reward
		// here, and quality climbs more slowly (20% of floor per level).
		int budget = BudgetAt(int(level), 20) * n;
		if (budget <= 0) return;

		string what = RS_MinionCatalog.BundleOf(budget, n, Family());
		if (what == "") what = RS_MinionCatalog.CheapestIn(Family());
		if (what == "") return;

		Class<Actor> cls = what;
		if (!cls) return;

		for (int i = 0; i < n; i++)
		{
			double a = 360.0 * i / n;
			Vector3 at = target.pos + (cos(a) * 28, sin(a) * 28, 0);
			RS_Minion.Summon(player, src, cls, at, a);
		}
	}
}

// HUNTER -- this family dies faster to you.
class RS_CatCard_HunterBase : RS_CatCard_FamilyBase abstract
{
	override void OnDamageDealt(Actor pawn, Actor shot, Actor target, int damage)
	{
		if (!target || level <= 0 || damage <= 0) return;
		if (target.bFRIENDLY) return;
		if (RS_MinionCatalog.FamilyOf(target) != Family()) return;

		// Percentage bonus applied as a second, separate hit so it reads
		// on the damage feed and cannot be swallowed by the first hit's
		// resistances.
		int bonus = max(1, damage * (8 * int(level)) / 100);
		target.DamageMobj(shot, pawn, bonus, "Normal", DMG_THRUSTLESS);
	}
}

// TROPHY -- this family pays out when it dies.
class RS_CatCard_TrophyBase : RS_CatCard_FamilyBase abstract
{
	override void OnKill(PlayerPawn player, Actor shot, Actor target)
	{
		if (!player || !target || level <= 0) return;
		if (RS_MinionCatalog.FamilyOf(target) != Family()) return;

		// Scales with how dangerous the family is, so a baron trophy is
		// worth more than a zombieman one without a per-family table.
		int worth = RS_MinionCatalog.CostOf(target.GetClassName());
		if (worth <= 0) worth = 2;

		int heal = max(1, worth * int(level) / 6);
		player.GiveBody(heal, player.GetMaxHealth() + 50);

		if (level >= 6)
			player.A_GiveInventory("Clip", worth);
	}
}

// CULL -- this family does not get to limp away.
class RS_CatCard_CullBase : RS_CatCard_FamilyBase abstract
{
	override void OnDamageDealt(Actor pawn, Actor shot, Actor target, int damage)
	{
		if (!target || level <= 0 || target.health <= 0) return;
		if (target.bFRIENDLY) return;
		if (RS_MinionCatalog.FamilyOf(target) != Family()) return;

		// Threshold is a share of the thing's OWN max health, so this is
		// as meaningful against a baron as against a zombie rather than
		// being a flat number that trivializes one and never fires on
		// the other.
		int maxhp = target.GetMaxHealth(true);
		if (maxhp <= 0) maxhp = target.SpawnHealth();
		int cut = maxhp * (4 * int(level)) / 100;        // 4%..20%, mastery 24%
		if (target.health > cut) return;

		target.DamageMobj(shot, pawn, target.health + 1, "Normal", DMG_THRUSTLESS);
	}
}

// ---------------------------------------------------------------------
// Shared: theme cards. Subclass overrides Theme() only.
// ---------------------------------------------------------------------
class RS_CatCard_ThemeBase : TFLV_Upgrade_RS_SlateBase abstract
{
	virtual int Theme() { return -1; }

	override string KeyAxis() { return "behavior"; }
	override string ValueForLevel(int lvl) { return ""; }

	bool CardTakeable(TFLV_WeaponInfo info, string myName)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, myName)
			&& info.upgrades.Level(myName) < 6;
	}

	// -----------------------------------------------------------------
	// ROLE IS A PREFERENCE, NOT A REQUIREMENT.
	//
	// The first pass asked the registry for PAYLOAD entries of a theme
	// at HEADLINE role and took null for an answer. Measured afterward,
	// six of the eight Surge cards drew null every single time and two
	// of the eight Brand cards had no payload entry in their theme at
	// all -- eight dead cards, picked from a level-up screen, doing
	// nothing forever.
	//
	// A card must not depend on a tag having been applied. This walks
	// down: exact axis at the wanted role, then that axis at any role,
	// then the theme's other visual axes in order of how much they read
	// like an effect. Only a theme with NO entries anywhere returns null,
	// and there is no such theme.
	// -----------------------------------------------------------------
	Class<Actor> DrawThemed(int wantRole)
	{
		Class<Actor> c;

		c = RS_FXRegistry.Draw(RS_FXRegistry.RS_FXAXIS_PAYLOAD, Theme(), wantRole);
		if (c) return c;
		c = RS_FXRegistry.Draw(RS_FXRegistry.RS_FXAXIS_SPARKS, Theme(), wantRole);
		if (c) return c;

		// Role dropped. Anything of this theme that can be seen.
		int axes[5];
		axes[0] = RS_FXRegistry.RS_FXAXIS_PAYLOAD;
		axes[1] = RS_FXRegistry.RS_FXAXIS_SPARKS;
		axes[2] = RS_FXRegistry.RS_FXAXIS_PUFF;
		axes[3] = RS_FXRegistry.RS_FXAXIS_PROJECTILE;
		axes[4] = RS_FXRegistry.RS_FXAXIS_TRAIL;
		for (int i = 0; i < 5; i++)
		{
			c = RS_FXRegistry.Draw(axes[i], Theme());
			if (c) return c;
		}
		return null;
	}
}

// BRAND -- hits plant this theme's payload at the impact.
class RS_CatCard_BrandBase : RS_CatCard_ThemeBase abstract
{
	// A brand is a THREE-AXIS claim: the round itself, what it leaves
	// behind it, and what it does where it lands -- all from one theme.
	// That is the "firebullet" shape. Three axes and not eight, so the
	// gun still sounds and ejects like itself.
	override void ExtraActivate(RS_Weapon wpn)
	{
		if (!wpn) return;
		ReleaseAxes(wpn);

		int want = (level >= 4) ? RS_FXRegistry.RS_FXROLE_HEADLINE
		                        : RS_FXRegistry.RS_FXROLE_BODY;

		// PROJECTILE arrives first, and only from level 2 -- level 1 is
		// the impact alone, so the card grows from "it burns what it
		// hits" into "it fires burning rounds".
		if (level >= 2)
			ClaimProj(wpn, RS_FXRegistry.Draw(
				RS_FXRegistry.RS_FXAXIS_PROJECTILE, Theme(), -1, false, false));

		ClaimPuff(wpn, RS_FXRegistry.Draw(
			RS_FXRegistry.RS_FXAXIS_PUFF, Theme(), want, false, false));

		if (level >= 3)
			ClaimTrail(wpn, RS_FXRegistry.Draw(
				RS_FXRegistry.RS_FXAXIS_TRAIL, Theme(), -1, false, false));

		// Nothing in this theme on any of those axes: fall back to the
		// walker so the card is never a dead pick.
		if (!mClaimProj && !mClaimPuff && !mClaimTrail)
			ClaimPuff(wpn, DrawThemed(want));
	}

	override void ExtraDeactivate(RS_Weapon wpn) { ReleaseAxes(wpn); }
}

// LOCK -- the gun's PACK beat draws only from this theme.
class RS_CatCard_LockBase : RS_CatCard_ThemeBase abstract
{
	// Which input this card's beat lands on. Slot 0 by default; a future
	// card can say "every 3rd ALT-fire" by overriding this to 1, or claim
	// a modifier input outright with 2 or 3.
	virtual int TargetSlot() { return RS_Weapon.RS_SLOT_PRIMARY; }

	void Reinstall(RS_Weapon wpn)
	{
		if (!wpn) return;

		// Own beats only. UninstallAll would strip Salvage's beat and
		// every other Attune card's too -- which is exactly what it did
		// before beats had owners, making all nine mutually exclusive
		// with no message saying so.
		RS_PACKAssembly.UninstallOwned(wpn, GetClassName());

		// Rotation tightens with level: every 5th shot down to every 2nd.
		//
		// Install() rather than pad-then-append by hand. The rotation
		// length is the slot array's length, so "every Nth" means the
		// array is N long -- Install pads to N-1 and appends, landing on
		// N. Doing it manually here padded to N and appended, giving N+1:
		// the card said every 5th and fired every 6th.
		int rot = max(2, 6 - int(level));
		let p = RS_PACKAssembly.Install(wpn, rot, Theme(), -1,
			TargetSlot(), GetClassName());
		if (!p) return;

		// Mastery: a second, independently rolled beat of the same theme
		// joins the cycle rather than lengthening it.
		if (level >= 6)
		{
			let q = RS_PACKAssembly.Build(wpn, Theme());
			if (q)
			{
				q.OwnerTag = GetClassName();
				wpn.AppendProfile(TargetSlot(), q);
			}
		}
	}

	override void ExtraActivate(RS_Weapon wpn)   { Reinstall(wpn); }

	// MANDATORY -- an appended profile with no card behind it fires
	// forever. Salvage learned this the hard way. Scoped to this card's
	// own beats so turning one Attune off leaves the others standing.
	override void ExtraDeactivate(RS_Weapon wpn)
	{
		RS_PACKAssembly.UninstallOwned(wpn, GetClassName());
	}
}

// SURGE -- kills burst this theme's headline FX.
class RS_CatCard_SurgeBase : RS_CatCard_ThemeBase abstract
{
	// Surge claims the LOUD axes -- what comes off the muzzle and what
	// flies off the impact -- while Brand claims the round and its
	// trail. Two theme cards on one gun therefore compose into a
	// complete themed shot instead of fighting over the same fields.
	override void ExtraActivate(RS_Weapon wpn)
	{
		if (!wpn) return;
		ReleaseAxes(wpn);

		ClaimSparks(wpn, RS_FXRegistry.Draw(
			RS_FXRegistry.RS_FXAXIS_SPARKS, Theme(), -1, false, false));

		if (level >= 2)
			ClaimSmoke(wpn, RS_FXRegistry.Draw(
				RS_FXRegistry.RS_FXAXIS_SMOKE, Theme(), -1, false, false));

		if (!mClaimSparks && !mClaimSmoke)
			ClaimSparks(wpn, DrawThemed(-1));
	}

	override void ExtraDeactivate(RS_Weapon wpn) { ReleaseAxes(wpn); }

	// The on-kill burst stays -- it is the card's signature, and it is
	// on death so it never competes with the shot the axes above changed.
	override void OnKill(PlayerPawn player, Actor shot, Actor target)
	{
		if (!player || !target || level <= 0) return;
		if (RS_Minion.IsMinion(target)) return;
		if (random(1, 100) > min(60, 10 * int(level))) return;

		Class<Actor> cls = DrawThemed(RS_FXRegistry.RS_FXROLE_HEADLINE);
		if (!cls) return;

		int n = (level >= 6) ? 3 : 1;
		for (int i = 0; i < n; i++)
		{
			double a = 360.0 * i / n;
			Vector3 at = target.pos + (cos(a) * 16 * i, sin(a) * 16 * i, 8);
			let mo = Actor.Spawn(cls, at, ALLOW_REPLACE);
			if (mo) { mo.target = player; mo.master = player; }
		}
	}
}

// ---------------------------------------------------------------------
// Shared: axis cards. Subclass overrides Axis() only.
// ---------------------------------------------------------------------
class RS_CatCard_AxisBase : TFLV_Upgrade_RS_SlateBase abstract
{
	virtual int Axis() { return -1; }

	override string KeyAxis() { return "behavior"; }
	override string ValueForLevel(int lvl) { return ""; }

	bool CardTakeable(TFLV_WeaponInfo info, string myName)
	{
		let wpn = RS_Weapon(info.wpn);
		return CanTake(wpn, info, myName)
			&& info.upgrades.Level(myName) < 6;
	}
}

// FLOURISH -- this axis is REPLACED on the gun, permanently, with the
// biggest thing the registry holds for it.
//
// This is the card that changes what your gun fires. It claims exactly
// one of the eight axes and leaves the other seven alone, so the gun
// keeps its own bang and brass and only the claimed axis changes --
// Flourish: Trail gives you a new trail on every shot and nothing else.
class RS_CatCard_FlourishBase : RS_CatCard_AxisBase abstract
{
	override void ExtraActivate(RS_Weapon wpn)
	{
		if (!wpn) return;
		ReleaseAxes(wpn);        // re-activation at a new level: rewrite, never stack

		// HEADLINE first -- the whole card is "show me the big version of
		// this axis". BODY is the honest fallback for axes with nothing
		// tagged headline yet, so the card is never inert.
		Class<Actor> cls = RS_FXRegistry.Draw(
			Axis(), -1, RS_FXRegistry.RS_FXROLE_HEADLINE, true, level < 6);
		if (!cls)
			cls = RS_FXRegistry.Draw(
				Axis(), -1, RS_FXRegistry.RS_FXROLE_BODY, true, level < 6);
		if (!cls)
			cls = RS_FXRegistry.Draw(Axis(), -1);
		ClaimByAxis(wpn, Axis(), cls);
	}

	override void ExtraDeactivate(RS_Weapon wpn) { ReleaseAxes(wpn); }
}

// ECHO -- the axis fires again, off the kill.
class RS_CatCard_EchoBase : RS_CatCard_AxisBase abstract
{
	// Echo claims the same axis Flourish does, but asks for an ACCENT --
	// the small detail entries rather than the headline ones. So on a
	// gun holding both, whichever was taken later owns the axis and the
	// other's ReleaseAxes correctly declines to clear it.
	override void ExtraActivate(RS_Weapon wpn)
	{
		if (!wpn) return;
		ReleaseAxes(wpn);

		Class<Actor> cls = RS_FXRegistry.Draw(
			Axis(), -1, RS_FXRegistry.RS_FXROLE_ACCENT, true, level < 6);
		if (!cls)
			cls = RS_FXRegistry.Draw(Axis(), -1, -1, true, level < 6);
		ClaimByAxis(wpn, Axis(), cls);
	}

	override void ExtraDeactivate(RS_Weapon wpn) { ReleaseAxes(wpn); }

	// And the scatter on death stays, which is what "echo" means.
	override void OnKill(PlayerPawn player, Actor shot, Actor target)
	{
		if (!player || !target || level <= 0) return;
		if (RS_Minion.IsMinion(target)) return;

		int n = min(4, 1 + int(level) / 2);
		for (int i = 0; i < n; i++)
		{
			if (random(1, 100) > min(75, 14 * int(level))) continue;

			Class<Actor> cls = RS_FXRegistry.Draw(Axis(), -1, -1, true, level < 6);
			if (!cls) return;

			double a = frandom(0, 360);
			double d = frandom(0, 40);
			Vector3 at = target.pos + (cos(a) * d, sin(a) * d, frandom(0, 24));
			let mo = Actor.Spawn(cls, at, ALLOW_REPLACE);
			if (mo) { mo.target = player; mo.master = player; }
		}
	}
}
