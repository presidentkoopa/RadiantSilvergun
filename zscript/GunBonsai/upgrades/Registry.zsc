// #namespace TFLV::Upgrade;
// #debug off

class TFLV_Upgrade_Registry : Object play {
  array<string> upgrade_names;
  array<string> unregistered;
  array<TFLV_Upgrade_BaseUpgrade> upgrades;

  static TFLV_Upgrade_Registry GetRegistry() {
    let reg = TFLV_EventHandler(StaticEventHandler.Find("TFLV_EventHandler"));
    if (!reg) return null;
    return reg.UPGRADE_REGISTRY;
  }

  int FindRegistration(string upgrade) {
    let idx = upgrade_names.find(upgrade);
    if (idx == upgrade_names.size()) return -1;
    return idx;
  }

  bool IsUnregistered(string upgrade) {
    return unregistered.find(upgrade) != unregistered.size();
  }

  // RS-authored affixes (zscript/GunBonsai/rs_upgrades/, class prefix
  // TFLV_Upgrade_RS_) are always eligible. Everything else is the
  // vendored stock pool -- gated behind rs_gb_legacy_affixes, off by
  // default. One choke point instead of touching 50+ individual
  // upgrade files: both generator functions below already loop through
  // every registered upgrade and check suitability here first.
  static bool IsRSAllowed(string upgrade_name) {
    if (upgrade_name.Left(15) == "TFLV_Upgrade_RS")
      return true;
    let cv = CVar.FindCVar("rs_gb_legacy_affixes");
    return cv && cv.GetBool();
  }

  // PLAYER-SCOPE UPGRADES ARE NOT GATED. Owner ruling 2026-08-07:
  // "gunbonsai has player-affixes or level up rewards, we will make our
  // own, but for now they can stay."
  //
  // Why this needs to be a separate gate at all: the WEAPON pool is
  // deliberately RS-only (the designed slate), so IsRSAllowed sends
  // every vendored upgrade away unless rs_gb_legacy_affixes is on. That
  // is correct for weapons and catastrophic for the player, because NOT
  // ONE RS-authored upgrade overrides IsSuitableForPlayer -- the base
  // returns false (BaseUpgrade.zsc). So the player candidate list was
  // ALWAYS EMPTY.
  //
  // What the player actually experienced: weapon levels fed 1 XP each
  // into a player track, the track filled, it announced "level up
  // ready" -- and there was nothing to give. Reached via console it
  // deducted the XP, incremented the level, and granted NOTHING,
  // silently. A progress bar wired to a door that was never built.
  //
  // Until RS has its own player rewards, the vendored ones fill that
  // slot. They are all player-scope by construction, so this cannot
  // leak stock upgrades into the weapon pool.
  static bool IsPlayerUpgradeAllowed(string upgrade_name) {
    return true;
  }

  bool Register(string upgrade) {
//    DEBUG("Register: %s", upgrade);
    if (IsUnregistered(upgrade)) {
      // Disabled by BONSAIRC.
      return false;
    }
    if (FindRegistration(upgrade) >= 0) {
      // Double-registrations are a no-op to make BONSAIRC more forgiving, and
      // are reported as successful.
      return true;
    }
    upgrade_names.push(upgrade);
    upgrades.push(TFLV_Upgrade_BaseUpgrade(new(upgrade)));
    return true;
  }

  void Unregister(string upgrade) {
//    DEBUG("Unregister: %s", upgrade);

    if (IsUnregistered(upgrade)) return;
    unregistered.push(upgrade);

    let idx = FindRegistration(upgrade);
    if (idx < 0) return;
    upgrade_names.delete(idx);
    upgrades.delete(idx);
  }

  // Returns true if Indestructable has delegated management of lives to Gun Bonsai.
  static bool IsIndestructableDelegated() {
    // NULL-GUARDED 2026-08-07, same reason as
    // TFLV_Upgrade_Indestructable.IsSuitableForPlayer: these three cvars
    // exist only when the Indestructable mod is loaded, FindCVar returns
    // null when it is not, and .GetInt() on null is a VM abort. Nothing
    // is delegated when the mod is absent, so the honest answer is false.
    let a = CVar.FindCVar("indestructable_starting_lives");
    let b = CVar.FindCVar("indestructable_lives_per_level");
    let c = CVar.FindCVar("indestructable_max_lives_per_level");
    if (!a || !b || !c) return false;
    return a.GetInt() == 0 && b.GetInt() == 0 && c.GetInt() == 0;
  }

  void PickN(Array<TFLV_Upgrade_BaseUpgrade> dst, Array<TFLV_Upgrade_BaseUpgrade> src, uint n) {
    uint max = src.size();
    while (max > 0 && dst.size() < n) {
      uint i = random[TFLV_Upgrade_RNG_UpgradePicker](0, max-1);
      dst.push(src[i]);
      src[i] = src[--max];
    }
  }

  void GenerateUpgradesForPlayer(
      TFLV_PerPlayerStats stats, Array<TFLV_Upgrade_BaseUpgrade> generated) {
    Array<TFLV_Upgrade_BaseUpgrade> candidates;
    let nrof = bonsai_upgrade_choices_per_player_level;

    if (nrof == -2) {
      // Debug mode -- return all upgrades, even invalid ones.
      generated.Copy(upgrades);
      return;
    }

    for (uint i = 0; i < upgrades.size(); ++i) {
      // IsPlayerUpgradeAllowed, not IsRSAllowed -- see its comment. The
      // weapon generator below keeps the RS-only gate; only the PLAYER
      // pool is open, because RS has no player upgrades of its own yet
      // and the alternative is an empty offer.
      if (IsPlayerUpgradeAllowed(upgrade_names[i]) && upgrades[i].IsSuitableForPlayer(stats))
        candidates.push(upgrades[i]);
    }

    if (nrof == -1) {
      // "All upgrades" mode
      generated.Copy(candidates);
    } else {
      PickN(generated, candidates, nrof);
    }
  }

  // RS GRAFT: extraCards is the count bought with Gold on this offer
  // (WeaponUpgradeGiver.rsExtraCards). Defaults to 0 so any other caller
  // -- including the vendored Service RPC -- is unaffected.
  void GenerateUpgradesForWeapon(
      TFLV_WeaponInfo info, Array<TFLV_Upgrade_BaseUpgrade> generated,
      int extraCards = 0) {
    array<TFLV_Upgrade_BaseUpgrade> candidates;
    let nrof = bonsai_upgrade_choices_per_gun_level;

    // RS GRAFT (rs_10): offer breadth is tier-driven -- higher-tier
    // guns literally see more possibility. Cursed/Trash/Basic still get
    // 2 -- never 0/1 -- because they hold no GunBonsai sockets (see the
    // designed affixes' socket gate below) and would otherwise see an
    // empty or pointless offer; the stat-card pool (which never checks
    // sockets) is what fills those 2 slots. rs_ui_offer_override > 0
    // forces a fixed count for tuning; the stock cvar's special values
    // (-1/-2) still win above.
    let rsw = RS_Weapon(info.wpn);
    if (rsw && nrof > 0) {
      int forced = CVar.GetCVar("rs_ui_offer_override", null).GetInt();
      if (forced > 0)                        nrof = forced;
      else if (rsw.Tier <= VRT_Basic)        nrof = 2;
      else if (rsw.Tier <= VRT_Uncommon)     nrof = 4;
      else if (rsw.Tier <= VRT_Designer)     nrof = 5;
      else                                   nrof = 6;
      // Cards bought with Gold on this offer (rs-ui-expand). Widening
      // the draw is strictly better than rerolling it -- pricier per
      // press, and the escalation makes a third or fourth card a real
      // decision rather than a formality.
      nrof += extraCards;
    }

    if (nrof == -2) {
      // Debug mode -- return all upgrades, even invalid ones.
      generated.Copy(upgrades);
      return;
    }

    for (uint i = 0; i < upgrades.size(); ++i) {
      if (IsRSAllowed(upgrade_names[i]) && upgrades[i].IsSuitableForWeapon(info) && info.CanAcceptUpgrade(upgrade_names[i]))
        candidates.push(upgrades[i]);
    }

    if (nrof == -1) {
      // "All upgrades" mode
      generated.Copy(candidates);
    } else {
      PickN(generated, candidates, nrof);
    }
  }
}
