// =====================================================================
// RS unified UI + designed affix slate strings.
// GunBonsai convention: <ClassName>_Name / _Desc looked up by
// BaseUpgrade.GetName()/GetDesc(); _TT is the tooltip body.
// =====================================================================
[en default]

RS_UI_SHEET_TITLE = "";

// --- The affix slate (docs/rs_09_affix_slate.txt) --------------------

TFLV_Upgrade_RS_Splitter_Name = "Splitter";
TFLV_Upgrade_RS_Splitter_Desc = "your shot divides -- more fragments, same total damage";
TFLV_Upgrade_RS_Splitter_TT = "Each level splits every shot into more, weaker fragments. Exact wash: coverage, not power. Mastery: the fragments form a fixed, even fan instead of random scatter.";

TFLV_Upgrade_RS_Slugger_Name = "Slugger";
TFLV_Upgrade_RS_Slugger_Desc = "the volley collapses into one heavy round";
TFLV_Upgrade_RS_Slugger_TT = "All pellets become a single slug: more damage per pull is traded for one precise round that grows with every level. Mastery: the slug punches through bodies.";

TFLV_Upgrade_RS_Overcharged_Name = "Overcharged";
TFLV_Upgrade_RS_Overcharged_Desc = "more damage, more spread -- the sloppiness is the price";
TFLV_Upgrade_RS_Overcharged_TT = "Damage and spread climb together, level by level. Mastery (Focus): the first shot after a deliberate pause pays no spread penalty.";

TFLV_Upgrade_RS_Giant_Name = "Giant";
TFLV_Upgrade_RS_Giant_Desc = "your rounds grow -- sprite and hitbox both";
TFLV_Upgrade_RS_Giant_TT = "Projectile scale climbs to comical sizes; the hitbox follows the art. Mastery (Wrecking Ball): rounds carry real kickback.";

TFLV_Upgrade_RS_Seeker_Name = "Seeker";
TFLV_Upgrade_RS_Seeker_Desc = "rounds hunt -- levels let them cycle victims";
TFLV_Upgrade_RS_Seeker_TT = "Homes true from level 1. Each level lets the round retarget one more victim when its target dies. Costs 5% damage per level. Mastery: unlimited cycling, precise tracking, curves around corners.";

TFLV_Upgrade_RS_Ghost_Name = "Ghost Rounds";
TFLV_Upgrade_RS_Ghost_Desc = "rounds punch through bodies";
TFLV_Upgrade_RS_Ghost_TT = "Pierce 1/2/3/4/all victims, keeping 70-90% damage per punch-through. Mastery (the stitch): a piercing kill whips the round toward its next victim.";

TFLV_Upgrade_RS_Painter_Name = "Painter";
TFLV_Upgrade_RS_Painter_Desc = "your rounds become fire";
TFLV_Upgrade_RS_Painter_TT = "Part-swap: the gun's own fire style is rolled once when taken -- Wisp or Ember -- and is this gun's fire forever. +3% damage per level. Mastery: impacts ignite the ground.";

TFLV_Upgrade_RS_Bonecaller_Name = "Bonecaller";
TFLV_Upgrade_RS_Bonecaller_Desc = "your rounds become revenant bone tracers";
TFLV_Upgrade_RS_Bonecaller_TT = "The skeleton's own tracers, weapon-grade. Levels give each pellet a growing chance to hunt (25/50/75/100%). Mastery (twin-fire): every round doubles into a straight+seeking pair at half damage each.";

TFLV_Upgrade_RS_Cryo_Name = "Cryo";
TFLV_Upgrade_RS_Cryo_Desc = "your rounds become ice -- heavier, fewer chambered";
TFLV_Upgrade_RS_Cryo_TT = "Ice shards: +6% damage per level, -1 magazine capacity per 2 levels. Mastery: the round becomes a bouncing ice orb -- the first player round allowed to bounce.";

TFLV_Upgrade_RS_Echo_Name = "Echo";
TFLV_Upgrade_RS_Echo_Desc = "every Nth pull fires a free, enhanced beat";
TFLV_Upgrade_RS_Echo_TT = "Adds an echo beat to the trigger rotation: every 7th (down to 3rd) pull costs no ammo and fires a cluster round. Mastery: every 2nd.";

// --- Stat cards (green) ----------------------------------------------

TFLV_Upgrade_RS_CardDamage_Name = "Damage Up";
TFLV_Upgrade_RS_CardDamage_Desc = "permanent damage, capped by the promotion ceiling";
TFLV_Upgrade_RS_CardDamage_TT = "Permanent +damage (bigger on promoted guns). Cannot exceed the damage ceiling -- promote to raise it.";

TFLV_Upgrade_RS_CardAccuracy_Name = "Accuracy Up";
TFLV_Upgrade_RS_CardAccuracy_Desc = "permanent +2 accuracy";
TFLV_Upgrade_RS_CardAccuracy_TT = "Permanent +2 Accuracy, to a maximum of 98.";

TFLV_Upgrade_RS_CardCapacity_Name = "Capacity Up";
TFLV_Upgrade_RS_CardCapacity_Desc = "permanent +1 magazine";
TFLV_Upgrade_RS_CardCapacity_TT = "Permanent +1 magazine capacity.";

TFLV_Upgrade_RS_CardCrit_Name = "Crit Up";
TFLV_Upgrade_RS_CardCrit_Desc = "permanent +0.5% critical chance";
TFLV_Upgrade_RS_CardCrit_TT = "Permanent +0.5% chance of a x2 critical volley.";

TFLV_Upgrade_RS_CardChoke_Name = "Choke Up";
TFLV_Upgrade_RS_CardChoke_Desc = "tighter pellet cone (shotgun family)";
TFLV_Upgrade_RS_CardChoke_TT = "Permanent +0.05 Choke -- a tighter cone. Shotgun-family exclusive.";

TFLV_Upgrade_RS_CardReload_Name = "Reload Tune";
TFLV_Upgrade_RS_CardReload_Desc = "smoother reloads, bonus rounds";
TFLV_Upgrade_RS_CardReload_TT = "Permanent +0.05 Reload Speed. High reload speed chambers bonus rounds on every reload.";

// --- Combo cards (purple; promoted / high-tier guns) -----------------

TFLV_Upgrade_RS_ComboMarksman_Name = "Marksman's Package";
TFLV_Upgrade_RS_ComboMarksman_Desc = "+3 accuracy AND +0.75% crit";
TFLV_Upgrade_RS_ComboMarksman_TT = "Two related gains, one card. Offered to promoted or Advanced+ guns.";

TFLV_Upgrade_RS_ComboChamber_Name = "Extended Chamber";
TFLV_Upgrade_RS_ComboChamber_Desc = "+2 capacity AND +0.05 reload";
TFLV_Upgrade_RS_ComboChamber_TT = "Two related gains, one card. Offered to promoted or Advanced+ guns.";

TFLV_Upgrade_RS_ComboHotLoads_Name = "Hot Loads";
TFLV_Upgrade_RS_ComboHotLoads_Desc = "+damage; shotguns tighten, others kick";
TFLV_Upgrade_RS_ComboHotLoads_TT = "Ceiling-capped damage plus a family-flavored side: shotguns gain choke, everything else loses a little accuracy -- hot loads kick.";

TFLV_Upgrade_RS_ComboWinterKit_Name = "Winter Kit";
TFLV_Upgrade_RS_ComboWinterKit_Desc = "Cryo +1 level AND +1 capacity";
TFLV_Upgrade_RS_ComboWinterKit_TT = "Deepens a held Cryo affix one level and offsets its capacity price a step. Never grants the Mastery -- that pick is always yours to make.";

TFLV_Upgrade_RS_ComboTwinDiscipline_Name = "Twin Discipline";
TFLV_Upgrade_RS_ComboTwinDiscipline_Desc = "Splitter +1 level AND +2 accuracy";
TFLV_Upgrade_RS_ComboTwinDiscipline_TT = "Deepens a held Splitter affix one level and steadies the spray. Never grants the Mastery -- that pick is always yours to make.";
