addkeysection "Gun Bonsai" GunBonsai

// bonsai-show-info (upstream's original keybind) is intentionally not
// bound here -- gboh-unified-info is a strict superset (cycles offhand
// level-up -> mainhand level-up -> player level-up -> falls through to
// ShowInfo(), the exact thing bonsai-show-info triggers). Keeping both
// bound to "I" left one silently shadowing the other in Customize
// Controls; one clean keybind instead.
alias bonsai-show-info "netevent bonsai-show-info"
alias bonsai-dump "netevent bonsai-debug,info"

addmenukey "Check Levels (Offhand/Mainhand/Player)" gboh-unified-info
alias gboh-unified-info "netevent gboh-unified-info"
defaultbind I gboh-unified-info

addkeysection "Gun Bonsai/Legendoom Integration" GunBonsaiLegendoom

addmenukey "Cycle Legendoom Weapon Effect" bonsai_cycle_ld_effect
alias bonsai_cycle_ld_effect "netevent bonsai-cycle-ld-effect"
defaultbind P bonsai_cycle_ld_effect

addkeysection "Radiant Silvergun" RSMain

addmenukey "Give Current Weapon a Random Profile (Debug)" rs_debug_random_profile
alias rs_debug_random_profile "netevent rs_debug_random_profile"
defaultbind PGDN rs_debug_random_profile

// Twin weapon wheel PoC -- hold to open, release to equip both hands.
addmenukey "Twin Weapon Wheel (Hold)" +rs_wheel
alias +rs_wheel "netevent rs-wheel-on"
alias -rs_wheel "netevent rs-wheel-off"
defaultbind V +rs_wheel

// One-key door into the UI Debug page -- no console needed.
addmenukey "UI Debug Menu" rs_ui_debug
alias rs_ui_debug "openmenu RS_UIDebug"
defaultbind U rs_ui_debug

// ---------------------------------------------------------------------
// In-world panels. Fires whatever row the pointing hand is on -- the
// panel system's single "confirm", not a per-action bind.
//
// THIS BIND IS WHY THE FEATURE IS REACHABLE AT ALL. Aiming resolves a
// panel and a row, and the row carries a netevent name, but without
// something to fire it the whole interaction is console-only. It was,
// until this line existed.
// ---------------------------------------------------------------------
addmenukey "In-World Panel: Select Row" rs_panel_use
alias rs_panel_use "netevent rs-panel-use"
defaultbind MOUSE2 rs_panel_use
